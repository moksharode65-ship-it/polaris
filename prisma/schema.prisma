generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Research {
  id        String   @id @default(cuid())
  title     String
  abstract  String
  year      Int
  thumbnail String
  content   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Expedition {
  id          String   @id @default(cuid())
  title       String
  location    String
  year        Int
  image       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Story {
  id        String   @id @default(cuid())
  title     String
  author    String
  date      String
  image     String
  content   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
